# RabbitMQ connection string (required)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Topic exchange the platform publishes domain events to
RABBITMQ_EXCHANGE=vvi.topic.exchange
RABBITMQ_EXCHANGE_TYPE=topic

# Queue this service owns for consuming alert events
RABBITMQ_QUEUE=core-service.alerts

# Routing key pattern bound to the queue (topic wildcards allowed: * and #)
RABBITMQ_ALERTS_ROUTING_KEY=alert.#
