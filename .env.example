# Cadena de conexión a RabbitMQ (obligatoria).
# El hostname es el container_name del broker (vinculo-vial-rabbitmq), no
# el nombre de servicio de compose: ese alias es genérico y puede colisionar
# con el de otro repositorio en la red compartida vinculo-vial. "localhost"
# tampoco es válido entre contenedores. Usar
# amqp://guest:guest@localhost:5672/ solo al correr el binario directamente
# en el host contra un broker publicado al host.
RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/

# Topología declarada por este job
RABBITMQ_MAIN_EXCHANGE=vvi.topic.exchange
RABBITMQ_RETRY_EXCHANGE=vvi.retry.exchange
RABBITMQ_DLQ_EXCHANGE=vvi.dlq.exchange
RABBITMQ_UNROUTED_EXCHANGE=vvi.unrouted.exchange

# TTL (ms) de las colas .retry antes de reingresar al exchange principal
RETRY_TTL_MS=30000

# Entorno de ejecución. No participa en la declaración de topología; es la
# guarda de cmd/reset, que solo elimina la topología cuando ENV=local. En
# cualquier entorno real debe permanecer sin definir o en un valor distinto
# de "local".
ENV=local

# Bucket de evidencia (AWS S3). No hay emulador local: desarrollo usa un
# bucket real, propio del entorno.
# Región del bucket (obligatoria). Debe coincidir en Core, Alert e IA.
S3_REGION=us-east-1
# Timeout (ms) de cada operación contra S3
S3_TIMEOUT_MS=5000
# Nombre del bucket (obligatorio). Es global en AWS: lleva un sufijo único,
# uno por entorno.
EVIDENCE_BUCKET=vinculo-vial-evidence-dev-<sufijo>
# Días de vida de los originales cifrados que nunca recibieron veredicto
EVIDENCE_PENDING_DAYS=2
# Días de vida de los originales de alertas RED (ventana de apelación)
EVIDENCE_QUARANTINE_DAYS=15

# Bucket de Audit (AWS S3, US-11). Privado, SSE-S3, versionado y con S3
# Object Lock; sin retención por defecto: la fija Audit en cada objeto.
# Object Lock solo se puede habilitar al crear el bucket: si el nombre ya
# existe sin él, Core falla en la verificación y NO lo borra ni lo recrea.
# Nombre del bucket (obligatorio, distinto de EVIDENCE_BUCKET). Es global en
# AWS: lleva un sufijo único, uno por entorno. Debe coincidir con el
# AUDIT_BUCKET de vinculo-vial-audit.
AUDIT_BUCKET=vinculo-vial-audit-dev-<sufijo>

# Credenciales AWS (obligatorias con docker compose): cadena estándar del
# SDK. Solo en .env (ignorado por git); nunca en el compose ni commiteadas.
# En un entorno real, usar un rol IAM en lugar de claves estáticas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
