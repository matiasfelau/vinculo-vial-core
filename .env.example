# Cadena de conexión a RabbitMQ (obligatoria).
# Bajo docker-compose, "rabbitmq" es el hostname del servicio en la red
# bridge compartida — "localhost" NO es válido para comunicación entre
# contenedores. Usar amqp://guest:guest@localhost:5672/ solo al correr el
# binario directamente en el host contra un broker publicado al host.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Topología declarada por este job (US-05)
RABBITMQ_MAIN_EXCHANGE=vvi.topic.exchange
RABBITMQ_RETRY_EXCHANGE=vvi.retry.exchange
RABBITMQ_DLQ_EXCHANGE=vvi.dlq.exchange
RABBITMQ_UNROUTED_EXCHANGE=vvi.unrouted.exchange

# TTL (ms) de las colas .retry antes de reingresar al exchange principal
RETRY_TTL_MS=30000
